doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Noom - Video Conference
        link(rel="stylesheet", href="/public/css/style.css")
    body.chat-body
        .header
            .header-content
                .header-logo-section
                    .logo-icon-wrapper
                        svg.logo-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z")
                    div
                        h1.header-title Noom
                        p.header-subtitle Video Conference

        .chat-container
            #welcome
                .welcome-card
                    h2.welcome-title Join a Video Room
                    form
                        .input-wrapper
                            input#roomName.nickname-input(placeholder="Room name", required, type="text")
                            svg.input-icon.icon-translate(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z")
                        .input-wrapper
                            input#nickname.nickname-input(placeholder="Your nickname", required, type="text")
                            svg.input-icon.icon-translate(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
                        button.btn-primary.btn-hover(type="submit") Join Room

        #call.call-container.hidden
            .video-section
                .room-info
                    h3#roomTitle.room-title
                    span#participantCount.participant-count 2 participants

                .videos-grid
                    .video-wrapper
                        video#myFace.video-player(autoplay, playsinline, muted)
                        .video-label
                            span#myNickname You

                    .video-wrapper
                        video#peerFace.video-player(autoplay, playsinline)
                        .video-label
                            span#peerNickname Guest

                .video-controls
                    .controls-left
                        button#mute.control-btn.btn-hover
                            svg.control-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z")
                            span Mute

                        button#camera.control-btn.btn-hover
                            svg.control-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z")
                            span Camera On

                    .controls-right
                        select#cameras.camera-select
                        button#leaveRoom.control-btn.btn-danger.btn-hover
                            span Leave Room

            .chat-section
                .chat-header
                    h4.chat-title Chat
                    span#chatStatus.chat-status DataChannel

                .messages-container
                    ul#messageList.message-list

                .message-input-section
                    form#messageForm.message-form
                        .input-wrapper
                            input#messageInput.message-input(type="text" placeholder="Type a message...")
                        button.btn-send.btn-hover(type="submit")
                            span Send
                            svg.send-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8")

        .footer
            p.footer-text Built with WebRTC & Socket.io · Video Conference

        script(src="/socket.io/socket.io.js")
        script(src="/public/js/app.js")